# Managed by Ansible
{% if nginx_enable_https %}
server {
    listen 80;
    listen [::]:80;
    server_name {{ nginx_server_name }};
    client_max_body_size {{ nginx_client_max_body_size }};

    access_log {{ nginx_log_dir }}/{{ app_name }}.access.log;
    error_log {{ nginx_log_dir }}/{{ app_name }}.error.log;

    location /.well-known/acme-challenge/ {
        root {{ nginx_acme_webroot }};
    }

{% if nginx_redirect_http_to_https %}
    location / {
        return 301 https://$host$request_uri;
    }
{% else %}
    root {{ web_root_dir }};
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /api/ws {
        proxy_pass http://{{ backend_bind_host }}:{{ backend_bind_port }};
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout {{ nginx_websocket_proxy_read_timeout }};
        proxy_send_timeout {{ nginx_websocket_proxy_send_timeout }};
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        proxy_pass http://{{ backend_bind_host }}:{{ backend_bind_port }};
        proxy_connect_timeout {{ nginx_api_proxy_connect_timeout }};
        proxy_read_timeout {{ nginx_api_proxy_read_timeout }};
        proxy_send_timeout {{ nginx_api_proxy_send_timeout }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
    }
{% endif %}
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ nginx_server_name }};
    client_max_body_size {{ nginx_client_max_body_size }};

    ssl_certificate {{ nginx_active_ssl_certificate }};
    ssl_certificate_key {{ nginx_active_ssl_certificate_key }};
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_protocols TLSv1.2 TLSv1.3;

    root {{ web_root_dir }};
    index index.html;

    access_log {{ nginx_log_dir }}/{{ app_name }}.access.log;
